DATABASE_URL=postgresql://...
MQTT_BROKER_URL=tls://xxxx.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=
PYTHON_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=
CALIBRATION_MINUTES=10080

# HTTP API
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
# Project URL; used to fetch the JWKS for projects that sign tokens with ES256/RS256 (new default)
SUPABASE_URL=https://<project-ref>.supabase.co
# for legacy projects that still sign tokens with a shared secret (HS256)
SUPABASE_JWT_SECRET=

# Web Push (leave empty to disable). Generate the keys with: go run ./cmd/vapidgen -env .env
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services; a mailto: or https: URL, e.g. mailto:you@yourdomain.com
VAPID_SUBJECT=
